    "version": "0.2.0",
    "configurations": [
        {
            "name": "train (with position)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/train.py",
            "args": [
                "--config", "configs/mobilenetv2.yaml",
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "eval-test",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/eval.py",
            "args": [
                "--config", "configs/default.yaml",
                "--checkpoint", "checkpoints/best.pt",
                "--root", "dataset/110_video_frames_2025_11_all_200_have_json",
                "--test-csv", "dataset/110_video_frames_2025_11_all_200_have_json/test.csv"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
